# QuickCart Environment Configuration Template

# Server Configuration
# PORT is automatically provided by platforms like Render; falls back to SERVER_PORT if unset
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

# Database Configuration (PostgreSQL 16 via pgxpool)
# For Neon in production: postgres://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgres://quickcart:quickcart_secret@localhost:5433/quickcart?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_DELAY=1m

# Redis / Valkey Configuration (Cache, Rate Limiting & Live SSE Pub/Sub)
# For Aiven Valkey with TLS in production: rediss://[user]:[password]@[aiven-host]:[port]
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Concurrency Worker Pool
WORKER_POOL_SIZE=4
WORKER_DRAIN_TIMEOUT=5s

# Authentication (JWT HMAC-SHA256, minimum 32 characters in production)
JWT_SECRET=quickcart-dev-jwt-super-secret-key-32bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Prometheus Metrics Scrape Token (Required in production for GET /metrics)
METRICS_TOKEN=quickcart-metrics-scrape-token
