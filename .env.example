# QuickCart Environment Configuration Template

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=5s

# Database Configuration (PostgreSQL 16 via pgxpool)
DATABASE_URL=postgres://quickcart:quickcart_secret@localhost:5432/quickcart?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_DELAY=1m

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
